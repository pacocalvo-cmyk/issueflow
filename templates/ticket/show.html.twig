{#  Esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}

{# Usamos el ID del ticket para construir un título de página específico. #}
{% block title %}{{ ticket.code }} . Issueflow{% endblock %}

{% block body %}
    {#
        Verifico con app.request.hasPreviousSession si existe una sesión activa,
        ya que si no la hay tampoco habrá mensajes que buscar, además, si no hiciera
        esta comprobación, el solo hecho de intentar leer con app.flashes() crearía una
        nueva sesión.
        app.flashes('success') es un arreglo que contiene todos los mensajes
        flash de tipo 'success', cuando los leo también los consumo, es decir,
        dejan de existir a continuación
    #}
    {% if app.request.hasPreviousSession %}
        {% for message in app.flashes('success') %}
            <div class="flash-succes">
                {{ message }}

            </div>
        {% endfor %}
    {% endif %}
    <p>
        <a href="{{ path('app_ticket_index') }}">Volver a incidencias</a>
    </p>
    <p class="ticket-code">{{ ticket.code }}</p>
    <h1>{{ ticket.title }}</h1>
    <p>Prioridad: <strong>{{ ticket.priority.label }}</strong></p>
    <p>Estado: <strong>{{ ticket.status.label }}</strong></p>
    <p>
        categoría:
        {# antes de intentar acceder al name de categoria, tengo que verificar que
            category no sea nulo(si no se hace puede suceder un error) #}
        {% if ticket.category %}
            {{ ticket.category.name }}
        {% else %}
            Sin categoría
           
        {% endif %}
    </p>

    <p>

        Asignado a:
        {# antes de intentar acceder al name de assignee, tengo que verificar que
            assignee no sea nulo(si no se hace puede suceder un error) #}
        {% if ticket.assignee %}
            {{ ticket.assignee.name }}
        {% else %}
            Sin asignar
        {% endif %}
    </p>

    {# agregar tiempo de respuesta #}
    <p>Objetivo de respuesta: <strong>{{ responseTargetHours }} horas</strong></p>
    {# Agreganos el mensaje "Requiere atencion inmediata" solo si el 
        ticket tiene una prioridad urgente: TicketPriority::Urgent
        Todo lo que esté entre el {%if condicion%} y {% end if %}
        aparecerá solo si se cumple la condicion #}
        
    {% if ticket.urgent %}
        <p class="ticket-urgent">Requiere atención inmediata</p>
    {% endif %}
    {% if ticket.closed %}
        <p class="ticket-closed">Incidencia cerrada</p>
    {% endif %}
{% endblock %}
