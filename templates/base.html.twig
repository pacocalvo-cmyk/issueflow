{#
    Plantilla base de IssueFlow.
    Las demás vistas pueden heredar esta estructura mediante {% extends %}
    y sustituir únicamente los bloques que necesiten.
#}
<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        {# Las vistas hijas pueden reemplazar el título de la página. #}
        <title{% block title %}IssueFlow{% endblock %}</title>

        {# Bloque reservado para hojas de estilo adicionales #}
        {% block stylesheets %}
        {% endblock %}

        {# Bloque reservado para scripts #}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {#
            Symfony 8.1 puede trabajar con FrankenPHP Hot Reload.
            Este bloque solo se activa si la variable de servidor existe,
            por lo que no afecta a los alumnos que ejecuten PHP de otra forma.
        #}
        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="site-header">
            <div class="container header-inner">
                {# path() genera la URL a partir del nombre interno de una ruta Symfony #}
                <a class="brand" href="{{ path('app_home') }}">IssueFlow</a>
                
                {# Barra de navegación principal #}
                <nav>
                    <a href="{{ path('app_home') }}">Inicio</a>
                    <a href="{{ path('app_ticket_index') }}">Incidencias</a>
                    <a href="{{ path('app_health') }}">Estado</a>
                    {#
                        app.user es null si no hay un usuario autenticado, en caso
                        contrario contiene la entidad User
                    #}
                    {% if app.user %}
                        {# Si hay un usuario conectado, lo saludo, y muestro la opción de cerrar sesión  #}
                        <span>Hola, {{ app.user.name }}</span>
                        {#
                            Uso la ruta predeterminada de Symfony para cierre de sesión.
                            Desactivo data-turbo-prefetch para evitar que se ejecute en segundo plano
                            la opción de logout cuando el cursor del ratón se posa sobre el enlace de logout 
                        #}
                        <a href="{{ path('_logout_main') }}" data-turbo-prefetch="false">Cerrar sesión</a>
                    {% else %}
                        {# Si no hay un usuario conectado, muestro la opción de acceder #}
                        <a href="{{ path('app_login') }}">Acceder</a>
                    {% endif %}
                </nav>
            </div>
        </header>
        <main class="site-main">
            <div class="container">
                {# Aquí las vistas hijas colocan su contenido principal #}
                {% block body %}{% endblock %}
            </div>
        </main>
    </body>
</html>